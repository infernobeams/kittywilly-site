            return config ? new _EventSource(rewrite(url), config) : new _EventSource(rewrite(url));
        };
        window.EventSource.prototype = _EventSource.prototype;
        Object.setPrototypeOf(window.EventSource, _EventSource);
    }

    console.log('[Proxy Shim] URL rewriting active for Roblox APIs');
})();
</script><style>
