            const parsed = new URL(absoluteUrl, window.location.href);
            const host = parsed.hostname;
            if (/\.roblox\.com$/i.test(host) && host !== 'www.roblox.com') {
                return buildProxyUrl(parsed);
            }
            if (DOMAIN_MAP.hasOwnProperty(host)) {
                return DOMAIN_MAP[host] + parsed.pathname.replace(/^\//, '') + parsed.search + parsed.hash;
            }
        } catch (e) {}
        return url;
    }

    /* ── Patch Request & fetch ──────────────────────────────────── */
    const _Request = window.Request;
    if (_Request) {
        window.Request = function (input, init) {
            if (typeof input === 'string') {
                input = rewrite(input);
            } else if (input instanceof URL) {
                input = rewrite(input.href);
            }
            return new _Request(input, init);
        };
        window.Request.prototype = _Request.prototype;
    }

    const _fetch = window.fetch.bind(window);
    window.fetch = function (input, init) {
        if (typeof input === 'string') {
            input = rewrite(input);
        } else if (input instanceof URL) {
            input = rewrite(input.href);
        }
        return _fetch(input, init);
    };

    /* ── Patch XHR ─────────────────────────────────────────────── */
    const _xhrOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (method, url) {
        const rest = Array.prototype.slice.call(arguments, 2);
        return _xhrOpen.apply(this, [method, rewrite(url)].concat(rest));
    };

    const _sendBeacon = navigator.sendBeacon && navigator.sendBeacon.bind(navigator);
    if (_sendBeacon) {
        navigator.sendBeacon = function (url, data) {
            return _sendBeacon(rewrite(url), data);
        };
    }

    const _WebSocket = window.WebSocket;
    if (_WebSocket) {
        window.WebSocket = function (url, protocols) {
            const rewritten = rewrite(url);
            return protocols ? new _WebSocket(rewritten, protocols) : new _WebSocket(rewritten);
        };
        window.WebSocket.prototype = _WebSocket.prototype;
        Object.setPrototypeOf(window.WebSocket, _WebSocket);
    }

    const _EventSource = window.EventSource;
    if (_EventSource) {
        window.EventSource = function (url, config) {
            return config ? new _EventSource(rewrite(url), config) : new _EventSource(rewrite(url));
        };
        window.EventSource.prototype = _EventSource.prototype;
        Object.setPrototypeOf(window.EventSource, _EventSource);
    }

    console.log('[Proxy Shim] URL rewriting active for Roblox APIs');
})();
