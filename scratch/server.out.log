        }

        statusEl.textContent = 'Showing live accessory thumbnails from Roblox.';
        gridEl.innerHTML = assetIds.map((assetId, index) => {
            const thumbUrl = toLocalImage(thumbnailMap[assetId] || '');
            const thumbMarkup = thumbUrl
